{
  "manifest_version": 3,
  "name": "YouTube Digest",
  "version": "0.3.0",
  "description": "在 YouTube、X 和哔哩哔哩观看视频时阅读字幕、翻译和概览，并保存笔记。",
  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting", "clipboardWrite"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://m.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://www.bilibili.com/*",
    "https://m.bilibili.com/*",
    "https://api.supadata.ai/*",
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": ["https://api.bilibili.com/*", "https://*.hdslb.com/*"],
  "action": { "default_title": "打开 YouTube Digest" },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html" },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://m.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://www.bilibili.com/*",
        "https://m.bilibili.com/*"
      ],
      "js": ["settings.js", "lib/player.js", "safari/content.js"],
      "css": ["safari/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html"],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://m.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://www.bilibili.com/*",
        "https://m.bilibili.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
